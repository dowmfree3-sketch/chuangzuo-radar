# 创作雷达 · 后端环境变量示例
# 复制为 .env 并填入真实值（.env 不会被提交）

# ===== OpenRouter（真实大模型，只用免费模型）=====
# 注册获取：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# 默认免费模型（已内置限流重试 + 多免费模型兜底，详见 server.py）
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# 兜底免费模型：任一被限流会自动尝试下一个（全部 :free，绝不降级付费模型）
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,z-ai/glm-5.2:free

# ===== 小红书数据源（关键）=====
# 可选值：none（默认，会如实报错）| ddg | tavily | rest
# 免费方案（覆盖有限，多数主题词会诚实返回「未找到相关视频」）：
#   tavily（Tavily 搜索 API，免费档 1000 积分/月，仅索引小红书聚合页，过滤后常 0 条）
#   ddg（DuckDuckGo 网页搜索，无需密钥，但只返回少量固定的热门笔记、不按关键词检索）
# 推荐稳定方案：rest（指向你自己可控的合规小红书内容接口，能 100% 确认视频类型）
XHS_PROVIDER=tavily
# 当 XHS_PROVIDER=tavily 时，填写 Tavily 密钥（注册：https://app.tavily.com，API Keys 复制 tvly- 开头）
# 注意：Tavily 返回的是网页搜索结果（非结构化笔记元数据），无法 100% 保证视频类型，
# 本产品用「视频偏向检索 + 规则过滤」尽力取视频笔记；详见 xiaohongshu_adapter.py 头部说明。
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# 备选：当 XHS_PROVIDER=rest 时，填写你的合规接口基址。
# 接口约定见 xiaohongshu_adapter.py 顶部 CONTRACT：GET {XHS_REST_BASE}/search?q=&type=video&limit=
# 该接口需返回真实小红书视频笔记（含 url / author / type=video 等字段），能 100% 确认视频类型。
XHS_REST_BASE=
XHS_REST_KEY=

# ===== 运行 =====
PORT=8000
# 要托管的前端 HTML 绝对路径（默认自动查找同目录或桌面文件）
# APP_HTML=/Users/jolin/Desktop/22-app-merged+workflow.html
